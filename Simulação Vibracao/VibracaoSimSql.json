        "type": "function",
        "z": "c25619be2b446f79",
        "name": "Preparar SQL Eixos",
        "func": "let data = new Date();\n// Ajuste para o horário local (YYYY-MM-DD HH:mm:ss)\nlet agora = data.getFullYear() + \"-\" +\n    (\"0\" + (data.getMonth() + 1)).slice(-2) + \"-\" +\n    (\"0\" + data.getDate()).slice(-2) + \" \" +\n    (\"0\" + data.getHours()).slice(-2) + \":\" +\n    (\"0\" + data.getMinutes()).slice(-2) + \":\" +\n    (\"0\" + data.getSeconds()).slice(-2);\n\nlet tabela = \"\";\nlet coluna = \"\";\n\nif (msg.topic === \"Eixo X\") { tabela = \"EixoX\"; coluna = \"EixoXValor\"; }\nelse if (msg.topic === \"Eixo Y\") { tabela = \"EixoY\"; coluna = \"EixoYValor\"; }\nelse if (msg.topic === \"Eixo Z\") { tabela = \"EixoZ\"; coluna = \"EixoZValor\"; }\n\nmsg.topic = `INSERT INTO ${tabela} (${coluna}, EixoData) VALUES (${msg.payload}, '${agora}')`;\nreturn msg;",
