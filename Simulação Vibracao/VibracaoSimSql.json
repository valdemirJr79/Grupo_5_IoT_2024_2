    {
        "id": "e2813245167e9758",
        "type": "function",
        "z": "5030cef3b87c34df",
        "name": "function 1",
        "func": "// Recupera ou inicializa o tempo de início da simulação\nlet startTime = context.get('startTime') || Date.now();\nif (!context.get('startTime')) context.set('startTime', startTime);\n\n// Cálculo do tempo decorrido e da etapa atual (0 a 5)\nlet elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);\nlet step = Math.floor(elapsedSeconds / 5);\n\n// Reinicia a simulação após os 30 segundos (opcional)\nif (step > 5) {\n    step = 5; \n    // Se quiser que o ciclo recomece, use: context.set('startTime', Date.now()); step = 0;\n}\n\n// Definição das Amplitudes baseada na etapa\n// Etapa 0: 0 a 100 | Etapa 1: 100 a 280 ... Etapa 5: 820 a 1000\nlet maxAmpTotal = 1000;\nlet minAmpTotal = 0;\nlet numSteps = 6;\nlet increment = (maxAmpTotal - 100) / (numSteps - 1); // Incrementos de 180 por etapa\n\nlet currentMax = 100 + (step * increment);\nlet currentMin = step === 0 ? 0 : 100 + ((step - 1) * increment);\n\n// Função para gerar valor aleatório dentro do range da etapa\nfunction getVibration(min, max) {\n    let val = Math.random() * (max - min) + min;\n    return parseFloat((Math.random() > 0.5 ? val : -val).toFixed(2));\n}\n\n// Simulação dos Eixos\nlet vibX = getVibration(currentMin, currentMax);\nlet vibY = getVibration(currentMin, currentMax);\n// No eixo Z, somamos a gravidade (9.81) à vibração para simular o motor fixo\nlet vibZ = parseFloat((9.81 + getVibration(currentMin, currentMax)).toFixed(2));\n\n// Preparação das mensagens\nlet msgs = [\n    { topic: \"X\", payload: vibX, step: step + 1 },\n    { topic: \"Y\", payload: vibY, step: step + 1 },\n    { topic: \"Z\", payload: vibZ, step: step + 1 }\n];\n\nreturn [msgs];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 220,
