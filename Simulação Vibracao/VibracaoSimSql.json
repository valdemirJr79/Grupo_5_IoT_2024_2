    {
        "id": "8d121bbfc32b16b9",
        "type": "function",
        "z": "ab0f0b0fd8bc9c15",
        "name": "Simulador 3 Eixos (1000 Vpp)",
        "func": "let startTime = context.get('startTime') || Date.now();\nlet elapsed = Math.floor((Date.now() - startTime) / 1000);\n\n// Reset após 30s (6 etapas * 5s)\nif (elapsed >= 30) {\n    startTime = Date.now();\n    context.set('startTime', startTime);\n    elapsed = 0;\n}\ncontext.set('startTime', startTime);\n\n// Cálculo da etapa atual (0 a 5)\nlet step = Math.floor(elapsed / 5);\n\n// Configuração Pico a Pico (1000 Vpp = Pico de 500)\nlet maxPicoFinal = 500;\nlet picoInicial = 50;\nlet increment = (maxPicoFinal - picoInicial) / 5;\n\n// Define apenas o valor máximo da etapa. O mínimo agora é sempre 0.\nlet currentMax = picoInicial + (step * increment);\n\nfunction getVib(max) {\n    // Agora gera um valor aleatório de 0 até o máximo da etapa atual\n    let val = Math.random() * max;\n    // Define aleatoriamente se o pico é positivo ou negativo\n    return parseFloat((Math.random() > 0.5 ? val : -val).toFixed(2));\n}\n\n// Gerando os dados para os 3 eixos\nlet x = getVib(currentMax);\nlet y = getVib(currentMax);\n// Eixo Z com offset de gravidade (9.81)\nlet z = parseFloat((9.81 + getVib(currentMax)).toFixed(2));\n\n// Enviando as 3 mensagens individualmente para processamento e gráfico\nnode.send({ topic: \"Eixo X\", payload: x, step: step + 1, max_peak: currentMax });\nnode.send({ topic: \"Eixo Y\", payload: y, step: step + 1, max_peak: currentMax });\nnode.send({ topic: \"Eixo Z\", payload: z, step: step + 1, max_peak: currentMax });\n\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 160,
        "wires": [
            [
                "4bd15b9bb4efaab1",
                "46179f7409d15551"
            ]
        ]
    },
    {
        "id": "46179f7409d15551",
        "type": "function",
        "z": "ab0f0b0fd8bc9c15",
        "name": "Lógica de Alarme",
        "func": "const LIMIAR_CRITICO = 450;\n\n// Para o Eixo Z, ignoramos o offset da gravidade (9.81) no cálculo do alarme\nlet valorVerificacao = msg.topic === \"Eixo Z\" ? Math.abs(msg.payload - 9.81) : Math.abs(msg.payload);\n\nif (valorVerificacao > LIMIAR_CRITICO) {\n    msg.payload = \"⚠️ CRÍTICO: \" + msg.topic + \" ultrapassou limite! Valor: \" + msg.payload;\n    return msg;\n}\nreturn null;",
        "outputs": 1,
