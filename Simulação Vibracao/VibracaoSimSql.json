    {
        "id": "9022ae5ff9feb341",
        "type": "function",
        "z": "e1f2c5560f781db9",
        "name": "Simular Vibração Progressiva",
        "func": "// Recupera ou inicializa o tempo de início\nlet startTime = context.get('startTime') || Date.now();\n\n// Calcula o tempo decorrido\nlet elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);\n\n// LÓGICA DE REINÍCIO: Se passar de 30 segundos, reseta o ciclo\nif (elapsedSeconds >= 30) {\n    startTime = Date.now();\n    context.set('startTime', startTime);\n    elapsedSeconds = 0;\n}\n\nif (!context.get('startTime')) {\n    context.set('startTime', startTime);\n}\n\n// Cálculo da etapa atual (0 a 5)\nlet step = Math.floor(elapsedSeconds / 5);\n\n// CONFIGURAÇÃO PICO A PICO (Vpp)\n// Para 1000 pico a pico, o valor máximo real (amplitude de pico) é 500.\n// Etapa 1: Pico 50 (Vpp 100) -> Etapa 6: Pico 500 (Vpp 1000)\nlet maxPicoFinal = 500; \nlet picoInicial = 50;\nlet numSteps = 6;\nlet increment = (maxPicoFinal - picoInicial) / (numSteps - 1); // Aumenta 90 por etapa\n\nlet currentMax = picoInicial + (step * increment);\nlet currentMin = step === 0 ? 0 : picoInicial + ((step - 1) * increment);\n\n// Função para gerar vibração aleatória dentro do range da etapa\nfunction getVibration(min, max) {\n    // Gera um valor entre o mínimo e o máximo da etapa atual\n    let val = Math.random() * (max - min) + min;\n    // Define aleatoriamente se o pico é positivo ou negativo\n    return parseFloat((Math.random() > 0.5 ? val : -val).toFixed(2));\n}\n\n// Simulação dos Eixos\nlet vibX = getVibration(currentMin, currentMax);\nlet vibY = getVibration(currentMin, currentMax);\n// Eixo Z com gravidade (9.81) + vibração\nlet vibZ = parseFloat((9.81 + getVibration(currentMin, currentMax)).toFixed(2));\n\n// Preparação das mensagens\nlet msgs = [\n    { topic: \"X\", payload: vibX, vpp: (currentMax * 2).toFixed(0), step: step + 1 },\n    { topic: \"Y\", payload: vibY, vpp: (currentMax * 2).toFixed(0), step: step + 1 },\n    { topic: \"Z\", payload: vibZ, vpp: (currentMax * 2).toFixed(0), step: step + 1 }\n];\n\nreturn [msgs];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
