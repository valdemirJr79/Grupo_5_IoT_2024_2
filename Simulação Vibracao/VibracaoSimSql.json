    {
        "id": "532ce96fd5bc1928",
        "type": "function",
        "z": "27f2a2ad013295c8",
        "name": "Simulador 6 Etapas (1000 Vpp)",
        "func": "let startTime = context.get('startTime') || Date.now();\nlet elapsed = Math.floor((Date.now() - startTime) / 1000);\n\n// Reset após 30s (6 etapas * 5s)\nif (elapsed >= 30) {\n    startTime = Date.now();\n    context.set('startTime', startTime);\n    elapsed = 0;\n}\ncontext.set('startTime', startTime);\n\nlet step = Math.floor(elapsed / 5);\n\n// Configuração Pico a Pico (1000 Vpp = Pico de 500)\nlet maxPicoFinal = 500;\nlet picoInicial = 50;\nlet increment = (maxPicoFinal - picoInicial) / 5;\n\nlet currentMax = picoInicial + (step * increment);\nlet currentMin = step === 0 ? 0 : picoInicial + ((step - 1) * increment);\n\nfunction getVib(min, max) {\n    let val = Math.random() * (max - min) + min;\n    return parseFloat((Math.random() > 0.5 ? val : -val).toFixed(2));\n}\n\nlet x = getVib(currentMin, currentMax);\nlet y = getVib(currentMin, currentMax);\nlet z = parseFloat((9.81 + getVib(currentMin, currentMax)).toFixed(2));\n\nreturn [\n    { topic: \"X\", payload: x, step: step + 1 },\n    { topic: \"Y\", payload: y, step: step + 1 },\n    { topic: \"Z\", payload: z, step: step + 1 }\n];",
