                "dbg_in"
            ]
        ]
    },
    {
        "id": "fn_main_1",
        "type": "function",
        "z": "tab1",
        "name": "Update Parking Status",
        "func": "let msgIn = msg.payload;\n\nlet spot = flow.get(\"spot\") || \"A1\";\n\nlet statusEnum;\n\nif (msgIn === \"Vaga ocupada\") {\n    statusEnum = \"Ocupado\";\n} else if (msgIn === \"Vaga livre\") {\n    statusEnum = \"Livre\";\n} else {\n    node.error(\"Unknown status: \" + msgIn);\n    return null;\n}\n\nmsg.topic = `UPDATE estacionamento SET estacionamentostatus = ? WHERE estacionamentonumero = ?`;\nmsg.payload = [statusEnum, spot];\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 120,
        "wires": [
            [
                "mysql_1",
                "dbg_out"
            ]
        ]
    },
    {
