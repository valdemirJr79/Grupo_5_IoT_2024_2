    {
        "id": "fn_set_spot",
        "type": "function",
        "z": "tab1",
        "name": "Set Parking Spot",
        "func": "flow.set(\"spot\", msg.payload);\nnode.status({fill:\"blue\",shape:\"dot\",text:\"Spot: \" + msg.payload});\nreturn msg;",
