                "3487edc41d6a117f"
            ]
        ]
    },
    {
        "id": "7a805ff3aa05e4f6",
        "type": "function",
        "z": "75791d2f481321cf",
        "name": "Gerar SQL",
        "func": "let data = new Date();\nlet agora = data.getFullYear() + \"-\" +\n    (\"0\" + (data.getMonth() + 1)).slice(-2) + \"-\" +\n    (\"0\" + data.getDate()).slice(-2) + \" \" +\n    (\"0\" + data.getHours()).slice(-2) + \":\" +\n    (\"0\" + data.getMinutes()).slice(-2) + \":\" +\n    (\"0\" + data.getSeconds()).slice(-2);\n\nlet x = msg.payload.x;\nlet y = msg.payload.y;\nlet z = msg.payload.z;\n\nmsg.topic = `INSERT INTO adxl345 (x, y, z, datahora) VALUES (${x}, ${y}, ${z}, '${agora}')`;\nreturn msg;",
