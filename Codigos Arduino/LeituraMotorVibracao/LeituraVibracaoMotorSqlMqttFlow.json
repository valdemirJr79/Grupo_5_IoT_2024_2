    {
        "id": "c3d675a7b9bc30ce",
        "type": "function",
        "z": "75791d2f481321cf",
        "name": "Parse X Y Z",
        "func": "let data = msg.payload;\n\nlet match = data.match(/X:\\s*(-?\\d+\\.?\\d*)\\s+Y:\\s*(-?\\d+\\.?\\d*)\\s+Z:\\s*(-?\\d+\\.?\\d*)/);\n\nif (match) {\n    let x = parseFloat(match[1]);\n    let y = parseFloat(match[2]);\n    let z = parseFloat(match[3]);\n\n    msg.payload = { x, y, z };\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 200,
        "wires": [
