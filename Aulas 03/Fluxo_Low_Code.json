    {
        "id": "3220e13e927d1e22",
        "type": "function",
        "z": "3938013e2d93f6f6",
        "name": "Simular vibração",
        "func": "\n//Simulação de vibração do ADXL345 em 3 eixos\nlet vibX = (Math.random() * 2 - 1).toFixed(2);  // Eixo X (-1 a 1 m/s²)\nlet vibY = (Math.random() * 2 - 1).toFixed(2);  // Eixo Y (-1 a 1m/s²)\nlet vibZ = (9.81 + (Math.random()) * 0.5 - 0.25).toFixed(2); // Eixo Z - \"9.81\" simula a gravidade \n\n\nlet msgs = [];\n\nmsgs.push({ topic: \"X\", payload: parseFloat(vibX) })\nmsgs.push({ topic: \"Y\", payload: parseFloat(vibY) })\nmsgs.push({ topic: \"Z\", payload: parseFloat(vibZ) })\n\nreturn [msgs];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 120,
