    {
        "id": "88672829573b16c3",
        "type": "function",
        "z": "3938013e2d93f6f6",
        "name": "Verificar limite",
        "func": "let limite = global.get(\"limiteTemp\") || 30;\nlet temp = msg.payload;\n\nif (temp >= limite) {\n    msg.status = \"ALARME!\";\n    msg.color = \"red\";\n\n} else {\n    msg.status = \"NORMAL\";\n    msg.color = \"green\";\n}\n\nmsg.limite = limite;\n\nreturn msg;\n\n\n",
        "outputs": 1,
        "timeout": 0,
