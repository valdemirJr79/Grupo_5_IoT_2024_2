    {
        "id": "28501d358f7510bf",
        "type": "function",
        "z": "2578216f7e7d0506",
        "name": "Calcular Diferencial",
        "func": "// Tópicos MQTT esperados:\n// senai/temperatura/sensor1\n// senai/temperatura/sensor2\n\nlet sensor1 = flow.get('sensor1');\nlet sensor2 = flow.get('sensor2');\n\nif (msg.topic === 'senai/temperatura/sensor1') {\n    sensor1 = Number(msg.payload);\n    flow.set('sensor1', sensor1);\n}\n\nif (msg.topic === 'senai/temperatura/sensor2') {\n    sensor2 = Number(msg.payload);\n    flow.set('sensor2', sensor2);\n}\n\n// Aguarda os dois sensores receberem valores\nif (sensor1 === undefined || sensor2 === undefined) {\n    return null;\n}\n\nlet diferencial = Math.abs(sensor1 - sensor2);\n\nlet status = 'NORMAL';\nlet cor = 'green';\n\nif (diferencial > 5 && diferencial < 15) {\n    status = 'ALERTA';\n    cor = 'yellow';\n}\n\nif (diferencial >= 15) {\n    status = 'PERIGO';\n    cor = 'red';\n}\n\nnode.status({\n    fill: cor,\n    shape: 'dot',\n    text: `${status} ΔT=${diferencial.toFixed(1)}°C`\n});\n\n// Mensagem SQL\nlet sqlMsg = {\n    topic: `INSERT INTO registros_temperatura (sensor1, sensor2, diferencial, status)\n             VALUES (${sensor1}, ${sensor2}, ${diferencial}, '${status}')`\n};\n\nreturn [\n    {\n        topic: 'Sensor 1',\n        payload: sensor1\n    },\n    {\n        topic: 'Sensor 2',\n        payload: sensor2\n    },\n    {\n        topic: 'Diferencial',\n        payload: diferencial\n    },\n    {\n        topic: 'Limite 5°C',\n        payload: 5\n    },\n    {\n        topic: 'Limite 15°C',\n        payload: 15\n    },\n    {\n        payload: {\n            sensor1: sensor1,\n            sensor2: sensor2,\n            diferencial: diferencial.toFixed(1),\n            status: status\n        }\n    },\n    sqlMsg\n];",
        "outputs": 7,
        "noerr": 0,
