    {
        "id": "0b39e335f3ab748a",
        "type": "function",
        "z": "99018d9797555cc3",
        "name": "Calculate Differential",
        "func": "// MQTT Topics Expected:\n// senai/temperatura/sensor1\n// senai/temperatura/sensor2\n\nlet sensor1 = flow.get('sensor1');\nlet sensor2 = flow.get('sensor2');\n\nif (msg.topic === 'senai/temperatura/sensor1') {\n    sensor1 = Number(msg.payload);\n    flow.set('sensor1', sensor1);\n}\n\nif (msg.topic === 'senai/temperatura/sensor2') {\n    sensor2 = Number(msg.payload);\n    flow.set('sensor2', sensor2);\n}\n\n// Wait until both sensors have values\nif (sensor1 === undefined || sensor2 === undefined) {\n    return null;\n}\n\nlet differential = Math.abs(sensor1 - sensor2);\n\nlet status = 'NORMAL';\nlet color = 'green';\n\nif (differential > 5 && differential < 15) {\n    status = 'ALERT';\n    color = 'yellow';\n}\n\nif (differential >= 15) {\n    status = 'DANGER';\n    color = 'red';\n}\n\nnode.status({\n    fill: color,\n    shape: 'dot',\n    text: `${status} ΔT=${differential.toFixed(1)}°C`\n});\n\n// Chart messages\nlet chartMessages = [\n    {\n        topic: 'Sensor 1',\n        payload: sensor1\n    },\n    {\n        topic: 'Sensor 2',\n        payload: sensor2\n    },\n    {\n        topic: 'Differential',\n        payload: differential\n    },\n    {\n        topic: 'Limit 5°C',\n        payload: 5\n    },\n    {\n        topic: 'Limit 15°C',\n        payload: 15\n    }\n];\n\n// Status message\nlet statusMessage = {\n    payload: {\n        sensor1: sensor1,\n        sensor2: sensor2,\n        differential: differential.toFixed(1),\n        status: status\n    }\n};\n\nreturn [chartMessages[0],\n        chartMessages[1],\n        chartMessages[2],\n        chartMessages[3],\n        chartMessages[4],\n        statusMessage];",
